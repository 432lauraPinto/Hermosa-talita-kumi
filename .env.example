# =====================================================================
# VARIABLES DE ENTORNO — HERMOSA TALITA KUMI
# Centro Estético Facial y Corporal
# =====================================================================

# 1. LOCALIZACIÓN Y ZONA HORARIA
TZ=America/La_Paz

# 2. SERVIDOR BACKEND (Node.js + Express)
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# 3. BASE DE DATOS MYSQL (Red interna Docker o Local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=estetica_user
DB_PASSWORD=estetica_pass_2026
DB_NAME=estetica_db
DB_ROOT_PASSWORD=root_secret_pass_2026

# 4. SEGURIDAD Y TOKENS JWT
JWT_SECRET=talita_kumi_jwt_access_secret_key_2026_secure
JWT_REFRESH_SECRET=talita_kumi_jwt_refresh_secret_key_2026_secure
ADMIN_INITIAL_PASSWORD=AdminTalita2026!

# 5. INTEGRACIÓN CON N8N Y AGENTE DE IA
N8N_SERVICE_API_KEY=htk_internal_n8n_service_token_2026
N8N_WEBHOOK_URL=http://localhost:5678/webhook/agente-ia
N8N_ENCRYPTION_KEY=htk_n8n_encryption_secret_key_2026
AI_PROVIDER=openai
OPENAI_API_KEY=

# 6. SUBIDA DE ARCHIVOS Y MULTIMEDIA (Solo PNG)
MAX_IMAGE_SIZE_MB=2
UPLOAD_DIR=./uploads

# 7. RESPALDOS AUTOMÁTICOS
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
