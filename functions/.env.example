# URL del webhook del flujo "HTK - Chatbot" en n8n
# Nota: si las Functions corren en el host y n8n en Docker con -p 5678:5678, localhost:5678 funciona directo.
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/htk-chatbot

# URL del webhook del flujo "HTK - Eventos de citas" en n8n
N8N_EVENTOS_WEBHOOK_URL=http://127.0.0.1:5678/webhook/htk-eventos-citas

# Clave compartida entre Cloud Functions (n8nApi) y los workflows de n8n (cabecera x-api-key)
N8N_API_KEY=htk-demo-n8n-secret-key-2026
