# En local, cualquier valor distinto de "false" conecta al emulador de Firebase
VITE_USE_EMULATORS=true

# Solo necesarios al pasar a producción con un proyecto Firebase real
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-hermosa-talita-kumi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-hermosa-talita-kumi
VITE_FIREBASE_STORAGE_BUCKET=demo-hermosa-talita-kumi.appspot.com
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
