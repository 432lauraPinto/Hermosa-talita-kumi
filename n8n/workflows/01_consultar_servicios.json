        "jsCode": "const servicios = $input.all().map(item => item.json);\nreturn [{\n  json: {\n    success: true,\n    total: servicios.length,\n    servicios: servicios,\n    mensaje: `Se encontraron ${servicios.length} tratamientos faciales y corporales activos.`\n  }\n}];"
      },
      "id": "node-code-formato-servicios",
